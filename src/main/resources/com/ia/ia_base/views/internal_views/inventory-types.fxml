         </columns>
      </TableView>
      <Button id="apply_filters_button" fx:id="new_inventory_type_button" layoutX="579.0" layoutY="150.0" mnemonicParsing="false" onAction="#openInventoryTypesView" prefHeight="31.0" prefWidth="171.0" styleClass="add_button" stylesheets="@../../../../../styles/filter.css" text="New Inventory Type" textFill="WHITE">
         <font>
            <Font name="SansSerif Regular" size="16.0" />
         </font>
      </Button>
      <Button id="apply_filters_button" fx:id="refresh_button" layoutX="421.0" layoutY="150.0" mnemonicParsing="false" onAction="#refreshTable" prefHeight="31.0" prefWidth="143.0" styleClass="cancel_button" stylesheets="@../../../../../styles/filter.css" text="Refresh Table">
