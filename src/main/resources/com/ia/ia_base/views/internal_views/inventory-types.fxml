<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../../../../../styles/device-attributes.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ia.ia_base.controllers.InventoryTypesController">
   <children>
      <Pane prefHeight="125.0" prefWidth="800.0" styleClass="accent" />
      <Label layoutX="50.0" layoutY="35.0" text="inventory types" textFill="#f5f6fa">
         <font>
            <Font name="Impact" size="48.0" />
         </font>
      </Label>
      <Button fx:id="cancel_button" layoutX="50.0" layoutY="535.0" mnemonicParsing="false" onAction="#closeAddInventoryTypeView" styleClass="cancel_button" text="Cancel" textFill="#2d2d2d">
         <font>
            <Font name="SansSerif Regular" size="16.0" />
         </font>
      </Button>
      <Button id="apply_filters_button" fx:id="done_button" layoutX="690.0" layoutY="535.0" mnemonicParsing="false" styleClass="add_button" stylesheets="@../../../../../styles/filter.css" text="Done" textFill="WHITE">
         <font>
            <Font name="SansSerif Regular" size="16.0" />
         </font>
      </Button>
      <TableView fx:id="inventory_type_table_view" layoutX="50.0" layoutY="210.0" prefHeight="300.0" prefWidth="700.0" styleClass="tree_table_view">
